---
// kinbosoft/src/components/Chat.astro
---

<div class="w-full bg-[#111111] border border-[rgba(244,243,239,0.16)] rounded-[8px] overflow-hidden shadow-2xl">
  {/* Terminal Top Window Bar */}
  <div class="px-5 py-3 border-b border-[rgba(244,243,239,0.12)] bg-[#181818] flex items-center justify-between font-mono text-xs text-[rgba(244,243,239,0.7)] select-none">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-[#D9261C]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#E5A93B]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#34D399]"></span>
      <span class="ml-2 text-white font-semibold">kinbo-systems-console // v5.1</span>
    </div>
    <div class="text-[#FF5A52]">
      [DIRECT ACCESS · ZERO SALES TEAM]
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12">
    {/* Left 5 Cols: Terminal Telemetry */}
    <div class="lg:col-span-5 p-6 sm:p-8 border-b lg:border-b-0 lg:border-r border-[rgba(244,243,239,0.12)] bg-[#0C0C0C] flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <div class="font-mono text-xs uppercase tracking-wider text-[#FF5A52]">
          CHANNEL 01 // DIRECT DISPATCH
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-tight">
          Systems Console
        </h2>
        <p class="text-xs sm:text-sm text-[rgba(244,243,239,0.75)] leading-relaxed">
          Transmit technical requirements, infrastructure parameters, or architecture audit inquiries directly to KINBO engineering leadership.
        </p>
      </div>

      <div class="space-y-2.5 font-mono text-xs border-t border-[rgba(244,243,239,0.1)] pt-5 text-[rgba(244,243,239,0.7)]">
        <div class="flex justify-between">
          <span>PRINCIPAL ARCHITECT:</span>
          <span class="text-white">ARJUN JAYESH</span>
        </div>
        <div class="flex justify-between">
          <span>OPERATIONAL ZONES:</span>
          <span class="text-white">INDIA // CHINA // GCC</span>
        </div>
        <div class="flex justify-between">
          <span>RESPONSE SLA:</span>
          <span class="text-[#FF5A52]">&lt; 4 BUSINESS HOURS</span>
        </div>
        <div class="flex justify-between">
          <span>COMMUNICATION:</span>
          <span class="text-white">DIRECT TO ENGINEER</span>
        </div>
      </div>
    </div>

    {/* Right 7 Cols: Interactive Terminal Transmission Form */}
    <div class="lg:col-span-7 p-6 sm:p-8 bg-[#111111]">
      <div class="flex items-center justify-between border-b border-[rgba(244,243,239,0.1)] pb-3 mb-6 font-mono text-xs text-[rgba(244,243,239,0.6)]">
        <span>session@kinbo-core:~# dispatch --stream</span>
        <span class="text-[#34D399]">TLS 1.3 SECURE</span>
      </div>

      <form id="terminal-contact-form" class="space-y-4 font-mono text-xs">
        {/* Honeypot */}
        <input
          type="text"
          name="_hp_company"
          tabindex="-1"
          autocomplete="off"
          style="position:absolute;left:-9999px;opacity:0;height:0;width:0;"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] text-[rgba(244,243,239,0.7)] uppercase mb-1">
              01. YOUR NAME *
            </label>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="e.g. Alex Mercer"
              class="w-full touch-target bg-[#181818] border border-[rgba(244,243,239,0.16)] rounded-[4px] px-3.5 py-2 text-white placeholder:text-[rgba(244,243,239,0.3)] focus:border-[#FF5A52] focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] text-[rgba(244,243,239,0.7)] uppercase mb-1">
              02. CONTACT EMAIL / PHONE *
            </label>
            <input
              type="text"
              name="email"
              required
              autocomplete="email"
              placeholder="e.g. founder@domain.com"
              class="w-full touch-target bg-[#181818] border border-[rgba(244,243,239,0.16)] rounded-[4px] px-3.5 py-2 text-white placeholder:text-[rgba(244,243,239,0.3)] focus:border-[#FF5A52] focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] text-[rgba(244,243,239,0.7)] uppercase mb-1">
              03. WHATSAPP TELEMETRY
            </label>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              placeholder="+91 98765 43210"
              class="w-full touch-target bg-[#181818] border border-[rgba(244,243,239,0.16)] rounded-[4px] px-3.5 py-2 text-white placeholder:text-[rgba(244,243,239,0.3)] focus:border-[#FF5A52] focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] text-[rgba(244,243,239,0.7)] uppercase mb-1">
              04. ORGANIZATION / ENTITY
            </label>
            <input
              type="text"
              name="organization"
              placeholder="e.g. St. Jude Healthcare"
              class="w-full touch-target bg-[#181818] border border-[rgba(244,243,239,0.16)] rounded-[4px] px-3.5 py-2 text-white placeholder:text-[rgba(244,243,239,0.3)] focus:border-[#FF5A52] focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-[11px] text-[rgba(244,243,239,0.7)] uppercase mb-1">
            05. ARCHITECTURE INQUIRY & SPECIFICATION *
          </label>
          <textarea
            name="message"
            required
            rows={4}
            placeholder="Detail technical requirements, expected concurrency, target platform, or clinical integration needs..."
            class="w-full bg-[#181818] border border-[rgba(244,243,239,0.16)] rounded-[4px] p-3 text-white placeholder:text-[rgba(244,243,239,0.3)] focus:border-[#FF5A52] focus:outline-none"
          ></textarea>
        </div>

        <div id="terminal-status-box" class="hidden font-mono text-xs p-3 rounded-[4px]"></div>

        <div class="pt-2">
          <button
            type="submit"
            id="terminal-submit-btn"
            class="touch-target px-6 py-3 bg-[#D9261C] hover:bg-[#B81D14] text-white font-bold uppercase tracking-wider rounded-[4px] transition-colors inline-flex items-center gap-2 cursor-pointer"
          >
            <span>[ EXECUTE TRANSMISSION → ]</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById("terminal-contact-form") as HTMLFormElement | null;
  const statusBox = document.getElementById("terminal-status-box");
  const submitBtn = document.getElementById("terminal-submit-btn");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const emailOrPhone = String(formData.get("email") || "");

      const payload = {
        form_type: "terminal_console",
        name: formData.get("name"),
        email: emailOrPhone.includes("@") ? emailOrPhone : "terminal_user@kinbosoft.com",
        phone: formData.get("phone") || (!emailOrPhone.includes("@") ? emailOrPhone : null),
        organization: formData.get("organization") || "Unspecified Entity",
        _hp_company: formData.get("_hp_company"),
        metadata: {
          message: formData.get("message"),
          source: "/chat",
        },
      };

      if (submitBtn) submitBtn.textContent = "[ TRANSMITTING... ]";

      try {
        const res = await fetch("/api/leads", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          form.reset();
          if (statusBox) {
            statusBox.className =
              "p-3 border border-[#34D399] bg-[#34D399]/10 text-[#34D399] text-xs rounded-[4px] block";
            statusBox.textContent =
              "[ACK 200]: Transmission logged in KINBO engineering ledger. Systems architect response < 4h.";
          }
        } else {
          throw new Error("Server rejected transmission.");
        }
      } catch {
        if (statusBox) {
          statusBox.className =
            "p-3 border border-[#D9261C] bg-[#D9261C]/10 text-[#FF5A52] text-xs rounded-[4px] block";
          statusBox.textContent =
            "[ERR 500]: Transmission fault. Please retry or use WhatsApp direct channel.";
        }
      } finally {
        if (submitBtn) submitBtn.textContent = "[ EXECUTE TRANSMISSION → ]";
      }
    });
  }
</script>
