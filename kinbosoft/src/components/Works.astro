---
import WorksFilter from "./WorksFilter";
---

<section id="works" class="py-16 border-t border-[rgba(244,243,239,0.14)]">
  <div class="max-w-6xl mx-auto">
    <div class="mb-10">
      <div class="font-mono text-[12px] text-[#FF5A52] uppercase mb-1">
        PORTFOLIO ARCHIVE
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-[#FFFFFF]">
        Selected Research & Systems
      </h2>
      <p class="text-sm text-[rgba(244,243,239,0.7)] mt-2">
        A chronological index of computational engines, simulation suites, and production software platforms.
      </p>
    </div>

    <WorksFilter client:load />
  </div>
</section>
