  <!-- =========================================================================
       PRODUCTION VANILLA JS (ZERO EXTERNAL LIBS, ZERO INLINE HANDLERS)
       ========================================================================= -->
  <script>
    (function () {
      'use strict';

      /* -----------------------------------------------------------------------
         CONFIGURATION - REPLACE WITH YOUR LIVE BUSINESS WHATSAPP NUMBER
         ----------------------------------------------------------------------- */
      const CONFIG = {
        WA_NUMBER: document.body.dataset.waNumber || '919846547132',
        USD_RATE: 84,
      };

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canHover = window.matchMedia('(hover: hover)').matches;
      let currentCurrency = 'INR';

      function buildWaUrl(message) {
        return `https://wa.me/${CONFIG.WA_NUMBER}?text=${encodeURIComponent(message)}`;
      }

      function formatMoney(inrAmount, prefix = '') {
        if (currentCurrency === 'INR') {
          return `${prefix}₹${Math.round(inrAmount).toLocaleString('en-IN')}`;
        }
        const usd = Math.max(10, Math.round(inrAmount / CONFIG.USD_RATE / 5) * 5);
        return `${prefix}$${usd.toLocaleString('en-US')}`;
      }

      /* Wire Static WhatsApp Links Cleanly */
      const defaultWaMsg = document.body.dataset.waMessage || 'Hi kinbo, I would like to talk directly to an engineer about a software project.';
      document.getElementById('closingWaLink').href = buildWaUrl(defaultWaMsg);
      document.getElementById('mobileBarWa').href = buildWaUrl(defaultWaMsg);

      /* -----------------------------------------------------------------------
         1. CSP-SAFE IMAGE FALLBACK HANDLERS (ZERO INLINE onerror)
         ----------------------------------------------------------------------- */
      document.querySelectorAll('.js-fallback-img').forEach((img) => {
        const hideImg = () => img.classList.add('is-hidden');
        img.addEventListener('error', hideImg);
        if (img.complete && img.naturalWidth === 0) hideImg();
      });

      /* -----------------------------------------------------------------------
         2. CPU-DISCIPLINED ORBITAL SUNRISE HERO CANVAS
            Pauses automatically via IntersectionObserver & visibilitychange.
            Renders 1 crisp static frame when prefers-reduced-motion is active.
         ----------------------------------------------------------------------- */
      const heroSection = document.getElementById('top');
      const canvas = document.getElementById('orbitalCanvas');
      const ctx = canvas ? canvas.getContext('2d') : null;
      let W = 0, H = 0, t = 0;
      let stars = [], cityLights = [];
      let mouseY = 0, targetMouseY = 0;
      let rafId = null;
      let heroVisible = true;

      function seedOrbitalScene() {
        stars = [];
        const starCount = Math.min(110, Math.floor((W * H) / 11500));
        for (let i = 0; i < starCount; i++) {
          stars.push({
            x: Math.random() * W,
            y: Math.random() * H * 0.66,
            r: Math.random() * 1.1 + 0.25,
            a: Math.random() * 0.45 + 0.12,
            p: Math.random() * Math.PI * 2,
          });
        }

        cityLights = [];
        const clusters = [
          { ang: -0.22, depth: 0.045 },
          { ang: -0.13, depth: 0.072 },
          { ang: -0.05, depth: 0.032 },
          { ang:  0.04, depth: 0.052 },
          { ang:  0.12, depth: 0.040 },
          { ang:  0.20, depth: 0.068 },
          { ang:  0.00, depth: 0.092 },
        ];
        clusters.forEach((c) => {
          const n = 14 + Math.floor(Math.random() * 12);
          for (let j = 0; j < n; j++) {
            cityLights.push({
              ang: c.ang + (Math.random() - 0.5) * 0.085,
              depth: Math.max(0.012, c.depth + (Math.random() - 0.5) * 0.045),
              r: Math.random() * 1.4 + 0.35,
              a: Math.random() * 0.65 + 0.25,
              p: Math.random() * Math.PI * 2,
            });
          }
        });
      }

      function resizeCanvas() {
        if (!canvas || !ctx) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas.getBoundingClientRect();
        W = Math.max(1, rect.width);
        H = Math.max(1, rect.height);
        canvas.width = Math.floor(W * dpr);
        canvas.height = Math.floor(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seedOrbitalScene();
        drawOrbitalFrame();
      }

      function drawOrbitalFrame() {
        if (!ctx || W === 0 || H === 0) return;
        mouseY += (targetMouseY - mouseY) * 0.06;
        const breath = prefersReduced ? 1 : 1 + Math.sin(t * 0.72) * 0.055;

        ctx.fillStyle = '#050505';
        ctx.fillRect(0, 0, W, H);

        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];
          const alpha = prefersReduced ? s.a : s.a * (0.7 + 0.3 * Math.sin(t * 1.6 + s.p));
          ctx.fillStyle = `rgba(244, 243, 239, ${alpha.toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(s.x, s.y + mouseY * 0.15, s.r, 0, Math.PI * 2);
          ctx.fill();
        }

        const cx = W * 0.5;
        const R = Math.max(W * 1.12, H * 1.35);
        const crestY = H * 0.74 + mouseY * 0.45;
        const cy = crestY + R;

        ctx.save();
        const outerGlow = ctx.createRadialGradient(cx, crestY, R * 0.01, cx, crestY, Math.max(W * 0.62, 340) * breath);
        outerGlow.addColorStop(0.00, 'rgba(255, 253, 245, 0.94)');
        outerGlow.addColorStop(0.11, 'rgba(255, 198, 92, 0.72)');
        outerGlow.addColorStop(0.28, 'rgba(255, 132, 36, 0.42)');
        outerGlow.addColorStop(0.54, 'rgba(217, 38, 28, 0.24)');
        outerGlow.addColorStop(0.82, 'rgba(120, 18, 12, 0.06)');
        outerGlow.addColorStop(1.00, 'rgba(5, 5, 5, 0)');
        ctx.fillStyle = outerGlow;
        ctx.fillRect(0, 0, W, H);

        ctx.beginPath();
        ctx.arc(cx, cy, R + 6, Math.PI * 1.25, Math.PI * 1.75);
        ctx.strokeStyle = 'rgba(217, 38, 28, 0.36)';
        ctx.lineWidth = 28 * breath;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, R + 2, Math.PI * 1.26, Math.PI * 1.74);
        ctx.strokeStyle = 'rgba(255, 158, 44, 0.60)';
        ctx.lineWidth = 10 * breath;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, R, Math.PI * 1.27, Math.PI * 1.73);
        ctx.strokeStyle = 'rgba(255, 245, 214, 0.94)';
        ctx.lineWidth = 2.4;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, R - 1, 0, Math.PI * 2);
        ctx.fillStyle = '#050505';
        ctx.fill();

        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, R - 1.5, 0, Math.PI * 2);
        ctx.clip();

        const innerBleed = ctx.createRadialGradient(cx, crestY - 12, 10, cx, crestY + 40, Math.max(W * 0.42, 240));
        innerBleed.addColorStop(0, 'rgba(255, 158, 44, 0.28)');
        innerBleed.addColorStop(0.45, 'rgba(217, 38, 28, 0.12)');
        innerBleed.addColorStop(1, 'rgba(5, 5, 5, 0)');
        ctx.fillStyle = innerBleed;
        ctx.fillRect(0, crestY - 20, W, H - crestY + 40);

        for (let i = 0; i < cityLights.length; i++) {
          const cl = cityLights[i];
          const rad = R * (1 - cl.depth);
          const lx = cx + Math.sin(cl.ang) * rad;
          const ly = cy - Math.cos(cl.ang) * rad;
          if (ly > H + 10 || ly < crestY + 4) continue;
          const fade = Math.max(0, 1 - (ly - crestY) / (H - crestY + 12));
          const tw = cl.a * fade * (prefersReduced ? 0.85 : 0.72 + 0.28 * Math.sin(t * 2.1 + cl.p));
          if (tw <= 0.02) continue;
          if (cl.r > 1.15) {
            ctx.fillStyle = `rgba(255, 178, 84, ${(tw * 0.28).toFixed(3)})`;
            ctx.beginPath();
            ctx.arc(lx, ly, cl.r * 3.1, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.fillStyle = `rgba(255, 226, 160, ${tw.toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(lx, ly, cl.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();

        ctx.globalCompositeOperation = 'screen';
        const flareW = Math.min(W * 0.68, 680) * breath;
        const flareGrad = ctx.createLinearGradient(cx - flareW / 2, crestY, cx + flareW / 2, crestY);
        flareGrad.addColorStop(0.00, 'rgba(217, 38, 28, 0)');
        flareGrad.addColorStop(0.24, 'rgba(255, 158, 44, 0.22)');
        flareGrad.addColorStop(0.45, 'rgba(255, 232, 185, 0.72)');
        flareGrad.addColorStop(0.50, 'rgba(255, 253, 245, 0.98)');
        flareGrad.addColorStop(0.55, 'rgba(255, 232, 185, 0.72)');
        flareGrad.addColorStop(0.76, 'rgba(255, 158, 44, 0.22)');
        flareGrad.addColorStop(1.00, 'rgba(217, 38, 28, 0)');
        ctx.fillStyle = flareGrad;
        ctx.fillRect(cx - flareW / 2, crestY - 2.2, flareW, 4.4);

        const coreR = Math.min(W * 0.085, 58) * breath;
        const coreGrad = ctx.createRadialGradient(cx, crestY, 0, cx, crestY, coreR);
        coreGrad.addColorStop(0.00, 'rgba(255, 253, 245, 1)');
        coreGrad.addColorStop(0.26, 'rgba(255, 244, 210, 0.92)');
        coreGrad.addColorStop(0.55, 'rgba(255, 168, 52, 0.45)');
        coreGrad.addColorStop(1.00, 'rgba(217, 38, 28, 0)');
        ctx.fillStyle = coreGrad;
        ctx.beginPath();
        ctx.arc(cx, crestY, coreR, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        const bottomFade = ctx.createLinearGradient(0, H * 0.86, 0, H);
        bottomFade.addColorStop(0, 'rgba(5, 5, 5, 0)');
        bottomFade.addColorStop(1, 'rgba(5, 5, 5, 0.95)');
        ctx.fillStyle = bottomFade;
        ctx.fillRect(0, H * 0.86, W, H * 0.14);
      }

      let lastFrameTime = 0;
      const targetFpsInterval = (window.innerWidth < 768) ? 42 : 28; // ~24fps on mobile, ~35fps on desktop

      function animateOrbital(currentTime) {
        if (prefersReduced || !heroVisible || document.hidden) {
          rafId = null;
          return;
        }
        rafId = requestAnimationFrame(animateOrbital);
        if (currentTime - lastFrameTime < targetFpsInterval) return;
        lastFrameTime = currentTime;
        t += 0.015;
        drawOrbitalFrame();
      }

      function syncCanvasLoop() {
        if (prefersReduced) return;
        if (heroVisible && !document.hidden) {
          if (rafId === null) rafId = requestAnimationFrame(animateOrbital);
        } else if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      }

      if ('IntersectionObserver' in window && heroSection) {
        const heroObs = new IntersectionObserver((entries) => {
          heroVisible = entries[0].isIntersecting;
          syncCanvasLoop();
        }, { threshold: 0.01 });
        heroObs.observe(heroSection);
      }

      document.addEventListener('visibilitychange', syncCanvasLoop);
      window.addEventListener('resize', resizeCanvas);
      if (!prefersReduced && canHover) {
        window.addEventListener('mousemove', (e) => {
          if (!heroVisible) return;
          targetMouseY = (e.clientY / Math.max(1, window.innerHeight) - 0.5) * 12;
        }, { passive: true });
      }

      resizeCanvas();
      syncCanvasLoop();

