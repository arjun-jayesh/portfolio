        const items = rateCatalog[estCat].items;
        estTierSelect.textContent = '';
        items.forEach((item, idx) => {
          const opt = document.createElement('option');
          opt.value = String(idx);
          const p = item.inr ? formatMoney(item.inr, item.prefix || '') : item.fallback;
          opt.textContent = `${item.name} - ${p}`;
          estTierSelect.appendChild(opt);
        });
        if (estTierIdx >= items.length) estTierIdx = 0;
        estTierSelect.value = String(estTierIdx);
      }

      function updateEstTierOptionLabelsInPlace() {
        const items = rateCatalog[estCat].items;
        const opts = estTierSelect.options;
        for (let i = 0; i < opts.length && i < items.length; i++) {
          const item = items[i];
          const p = item.inr ? formatMoney(item.inr, item.prefix || '') : item.fallback;
          opts[i].textContent = `${item.name} - ${p}`;
        }
      }

      function updateEstOutput() {
        const catObj = rateCatalog[estCat];
        const tier = catObj.items[estTierIdx];

        paceBtns.forEach((b) => {
          const active = b.dataset.pace === estPace;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });

        if (tier.inr) {
          const mult = estPace === 'priority' ? 1.15 : 1;
          const totalInr = Math.round((tier.inr * mult) / 100) * 100;
          const formatted = formatMoney(totalInr, tier.prefix || '');
          estPriceOut.textContent = formatted;
          estMilestoneGrid.hidden = false;
          estM1.textContent = formatMoney(totalInr * 0.30);
          estM2.textContent = formatMoney(totalInr * 0.40);
          estM3.textContent = formatMoney(totalInr * 0.30);
          currentEstSummary = `${catObj.title} - ${tier.name} (${estPace === 'priority' ? 'Priority +15%' : 'Standard'}) | Est. ${formatted}`;
        } else {
          estPriceOut.textContent = 'Contact Team';
          estMilestoneGrid.hidden = true;
          currentEstSummary = `${catObj.title} - ${tier.name} (Custom Engineering Proposal)`;
        }

        estWaBtn.href = buildWaUrl(`Hi kinbo, I'd like to talk to an engineer about: ${currentEstSummary}`);
      }

      estCatSelect.addEventListener('change', (e) => {
        estCat = e.target.value;
        estTierIdx = 0;
        rebuildEstTierOptions();
        updateEstOutput();
      });

      estTierSelect.addEventListener('change', (e) => {
        estTierIdx = Number(e.target.value);
        updateEstOutput();
      });

      paceBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          estPace = btn.dataset.pace;
          updateEstOutput();
        });
      });

      estBriefBtn.addEventListener('click', () => openBriefModal(currentEstSummary, estBriefBtn));

      /* Global Currency Toggle */
      const currBtns = document.querySelectorAll('.curr-btn');
      currBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCurrency = btn.dataset.currency;
          currBtns.forEach((b) => {
            const active = b.dataset.currency === currentCurrency;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', String(active));
          });
          renderRateTab();
          updateEstTierOptionLabelsInPlace(); /* Preserves focus & selection */
          updateEstOutput();
        });
      });

      renderRateTab();
      rebuildEstTierOptions();
      updateEstOutput();

      /* -----------------------------------------------------------------------
         6. ACCESSIBLE FAQ ACCORDION
         ----------------------------------------------------------------------- */
      document.querySelectorAll('.faq-trigger').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const item = trigger.closest('.faq-item');
          const isOpen = item.getAttribute('data-open') === 'true';
          item.setAttribute('data-open', String(!isOpen));
          trigger.setAttribute('aria-expanded', String(!isOpen));
        });
      });

      /* -----------------------------------------------------------------------
         7. DIRECT-TO-ENGINEER MODAL WITH FULL FOCUS TRAP & FOCUS RESTORATION
         ----------------------------------------------------------------------- */
      const briefBackdrop = document.getElementById('briefBackdrop');
      const briefModal = document.getElementById('briefModal');
      const briefCloseBtn = document.getElementById('briefCloseBtn');
      const briefFormWrap = document.getElementById('briefFormWrap');
      const briefConfirmWrap = document.getElementById('briefConfirmWrap');
      const projectBriefForm = document.getElementById('projectBriefForm');
      const bfName = document.getElementById('bfName');
      const bfContact = document.getElementById('bfContact');
      const bfGoal = document.getElementById('bfGoal');
      const bfError = document.getElementById('bfError');
      const modalWaDirect = document.getElementById('modalWaDirect');
      const briefConfirmMsg = document.getElementById('briefConfirmMsg');
      const confirmWaBtn = document.getElementById('confirmWaBtn');
      const briefDoneBtn = document.getElementById('briefDoneBtn');

      let lastFocusedEl = null;

      function syncModalWa() {
        const g = bfGoal.value.trim() || 'a custom software project';
        modalWaDirect.href = buildWaUrl(`Hi kinbo, I'd like to talk to an engineer about: ${g}`);
      }
      bfGoal.addEventListener('input', syncModalWa);

      function getFocusableInModal() {
        return Array.from(briefModal.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )).filter((el) => el.offsetParent !== null);
      }

      function openBriefModal(prefill = '', triggerEl = null) {
        lastFocusedEl = triggerEl || document.activeElement;
        briefFormWrap.hidden = false;
        briefConfirmWrap.hidden = true;
        bfError.hidden = true;
        if (prefill) bfGoal.value = prefill;
        syncModalWa();

        briefBackdrop.hidden = false;
        requestAnimationFrame(() => {
          briefBackdrop.classList.add('is-open');
          bfName.focus();
        });
        document.body.style.overflow = 'hidden';
      }

      function closeBriefModal() {
        briefBackdrop.classList.remove('is-open');
        document.body.style.overflow = '';
        setTimeout(() => {
          briefBackdrop.hidden = true;
          if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
            lastFocusedEl.focus();
          }
        }, 200);
      }

      document.querySelectorAll('[data-open-brief]').forEach((btn) => {
        btn.addEventListener('click', () => openBriefModal(btn.dataset.prefill || '', btn));
      });

      projectBriefForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = bfName.value.trim();
        const contact = bfContact.value.trim();
        const goal = bfGoal.value.trim();
        const hpInput = document.getElementById('bfCompany');
        const hpVal = hpInput ? hpInput.value.trim() : '';

        if (!name || !contact || !goal) {
          bfError.textContent = 'Please fill all 3 fields so an engineer can respond accurately.';
          bfError.hidden = false;
          return;
        }

        const submitBtn = projectBriefForm.querySelector('button[type="submit"]');
        const origBtnText = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Transmitting to Engineer...';
        }

        try {
          const res = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              contact,
              goal,
              form_type: 'Direct-to-Engineer Brief',
              source: 'homepage-brief-modal',
              _hp_company: hpVal
            })
          });

          const data = await res.json().catch(() => ({}));
          if (!res.ok && !data.success) {
            throw new Error(data.error || 'Server error. Please retry or contact via WhatsApp.');
          }

          bfError.hidden = true;
          briefConfirmMsg.textContent = `Thank you, ${name}. Your brief has been transmitted directly to our engineering team. An engineer will reply directly to ${contact} within 4 business hours.`;
          confirmWaBtn.href = buildWaUrl(`Hi kinbo, I'm ${name} (${contact}). Project brief: ${goal}`);
          briefFormWrap.hidden = true;
          briefConfirmWrap.hidden = false;
          projectBriefForm.reset();
          briefDoneBtn.focus();
        } catch (err) {
          console.error('Lead submission error:', err);
          bfError.textContent = err.message || 'Transmission failed. Please retry or message an engineer on WhatsApp directly.';
          bfError.hidden = false;
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = origBtnText;
          }
        }
      });

      briefCloseBtn.addEventListener('click', closeBriefModal);
      briefDoneBtn.addEventListener('click', closeBriefModal);
      briefBackdrop.addEventListener('click', (e) => {
        if (e.target === briefBackdrop) closeBriefModal();
      });

      /* Keyboard Focus Trap + Escape Handling */
      document.addEventListener('keydown', (e) => {
        if (briefBackdrop.hidden) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeBriefModal();
          return;
        }
        if (e.key === 'Tab') {
          const focusables = getFocusableInModal();
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    })();
  </script>
</body>
</html>