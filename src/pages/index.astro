---
import { supabase } from '../lib/supabase';
import Analytics from '@vercel/analytics/astro';

let whatsappNumber = "919846547132";
let whatsappMessage = "Hi kinbo, I would like to talk directly to an engineer about a software project.";
let companyName = "KINBO TECHNOLOGIES PRIVATE LIMITED";

if (supabase) {
  try {
    const { data: entData } = await supabase
      .from("site_config")
      .select("data")
      .eq("key", "enterprise_assets")
      .maybeSingle();
    if (entData?.data) {
      if (entData.data.whatsapp_number) {
        whatsappNumber = String(entData.data.whatsapp_number).replace(/[^0-9]/g, '');
      }
      if (entData.data.whatsapp_message) {
        whatsappMessage = entData.data.whatsapp_message;
      }
      if (entData.data.company_name) {
        companyName = entData.data.company_name;
      }
    }
  } catch (e) {
    console.error("SSR site_config fetch error in index.astro:", e);
  }
}

const defaultWaUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>kinbo - Custom Software Engineering, Direct to Engineer</title>
  <meta name="description" content="State-of-the-art apps, websites, ERPs, and AI systems built in Research-Build-Refine stages with lifelong support. Transparent rates from ₹7,000. Talk directly to an engineer.">
  <link rel="canonical" href="https://kinbosoft.com/">

  <!-- CSP-Safe Typography: Standard preconnect + display=swap stylesheet (zero inline onload) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

  <!-- Structured Data: Organization, WebSite, Service, and FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://kinbosoft.com/#organization",
        "name": "kinbo",
        "url": "https://kinbosoft.com/",
        "description": "Custom software engineering company building apps, websites, ERPs, AI systems, and custom software with direct-to-engineer communication from day one.",
        "areaServed": "Worldwide"
      },
      {
        "@type": "WebSite",
        "@id": "https://kinbosoft.com/#website",
        "url": "https://kinbosoft.com/",
        "name": "kinbo",
        "publisher": { "@id": "https://kinbosoft.com/#organization" }
      },
      {
        "@type": "Service",
        "@id": "https://kinbosoft.com/#services",
        "name": "Custom Software Engineering Services",
        "provider": { "@id": "https://kinbosoft.com/#organization" },
        "serviceType": [
          "Mobile App Development (Flutter, Kotlin)",
          "Websites & E-Commerce Platforms",
          "Education & Business ERP Systems",
          "AI Integration & Model Training",
          "Custom Python, Rust & Computer Vision Systems"
        ],
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "INR",
          "lowPrice": "3000",
          "highPrice": "91000"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://kinbosoft.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Who do I actually speak with when I contact kinbo?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You speak directly with the engineer architecting and building your system from day one. kinbo has no sales team or middlemen, and engineers reply within 4 business hours."
            }
          },
          {
            "@type": "Question",
            "name": "How do the 30 / 40 / 30 milestone payments work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "30% initiates the Research phase and locks the technical specification, 40% is billed only after you verify the working Build on a live staging link, and the final 30% settles upon Refine handover and full source-code transfer."
            }
          },
          {
            "@type": "Question",
            "name": "What does lifelong support* actually cover?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Lifelong support covers free critical bug fixes on our delivered scope, ongoing architectural consultations, and optional transparent AMC tiers for new features or server operations - with zero vendor lock-in."
            }
          },
          {
            "@type": "Question",
            "name": "Why are domain, hosting, and third-party APIs billed separately?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Domains, cloud servers, and API keys are registered directly in your name from day one so you maintain 100% ownership and pay real provider rates with zero agency markup."
            }
          },
          {
            "@type": "Question",
            "name": "Do you take on custom Python, Rust, Computer Vision, or AI Training projects?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. AI integrations start at ₹3,000 and custom AI model training starts at ₹23,000. Custom Python pipelines, Rust backends, computer vision, and analytics dashboards are scoped directly with an engineer."
            }
          }
        ]
      }
    ]
  }
  </script>

  <style is:global>
    /* =========================================================================
       KINBO PRODUCTION STATIC CSS - SWISS MODERNIST + ISLANDS (ZERO CDN)
       WCAG 2.2 AA Contrast Lock:
 - #D9261C: Large marks (>=24px), buttons with #FFFFFF text (5.06:1), borders
 - #FF5A52: Small labels/text (12px-14px) on dark #111111 (6.1:1)
 - #B81D14: Small labels/text (12px-14px) on light #F4F3EF (5.9:1)
       ========================================================================= */
    :root {
      --void: #050505;
      --carbon: #111111;
      --dark-surface: #181818;
      --ground: #F4F3EF;
      --surface: #FFFFFF;
      --surface-muted: #ECEAE4;
      --signal: #D9261C;
      --signal-light-bg: #B81D14;
      --signal-dark-bg: #FF5A52;
      --ink-light: #F4F3EF;
      --ink-light-muted: rgba(244, 243, 239, 0.78);
      --ink-dark: #111111;
      --ink-dark-muted: rgba(17, 17, 17, 0.72);
      --rule-light: rgba(17, 17, 17, 0.14);
      --rule-dark: rgba(244, 243, 239, 0.16);
      --radius-sm: 4px;
      --radius-md: 8px;
      --ease-damped: cubic-bezier(0.16, 1, 0.3, 1);
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      --container: 1280px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 88px;
      scroll-padding-bottom: 84px;
      font-size: 16px;
      background-color: var(--ground);
      color: var(--ink-dark);
    }

    body {
      margin: 0;
      font-family: var(--font-sans);
      font-size: 1rem;
      line-height: 1.6;
      background-color: var(--ground);
      color: var(--ink-dark);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    img {
      display: block;
      max-width: 100%;
    }

    button, input, select, textarea {
      font: inherit;
      color: inherit;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Screen-Reader Only Utility */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Hidden SVG Sprite */
    .svg-sprite {
      position: absolute;
      width: 0;
      height: 0;
      overflow: hidden;
    }

    /* Skip Link for Keyboard Users */
    .skip-link {
      position: fixed;
      top: -100px;
      left: 16px;
      z-index: 100;
      background: var(--carbon);
      color: var(--ink-light);
      padding: 12px 18px;
      border: 2px solid var(--signal-dark-bg);
      border-radius: var(--radius-sm);
      font-weight: 600;
    }
    .skip-link:focus {
      top: 16px;
    }

    /* High-Visibility WCAG 2.2 Focus Outlines */
    :focus-visible {
      outline: 2px solid var(--signal-light-bg);
      outline-offset: 2px;
    }
    .theme-dark :focus-visible,
    .nav-header :focus-visible,
    .mobile-bar :focus-visible {
      outline-color: var(--signal-dark-bg);
    }

    /* Layout Primitives */
    .container {
      width: 100%;
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: 16px;
    }
    @media (min-width: 640px) {
      .container { padding-inline: 28px; }
    }
    @media (min-width: 1024px) {
      .container { padding-inline: 40px; }
    }

    .section-pad {
      padding-block: 80px;
    }
    @media (min-width: 1024px) {
      .section-pad { padding-block: 112px; }
    }

    .mono-label {
      font-family: var(--font-mono);
      font-size: 0.75rem; /* 12px strict minimum */
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: inline-block;
    }
    .mono-accent-light { color: var(--signal-light-bg); }
    .mono-accent-dark  { color: var(--signal-dark-bg); }
    .tabular { font-variant-numeric: tabular-nums; }

    .display-title {
      margin: 0;
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.06;
    }

    /* Buttons (WCAG 2.5.8 >= 44px touch targets) */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      min-width: 44px;
      padding: 12px 24px;
      border-radius: var(--radius-sm);
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      border: 1px solid transparent;
      cursor: pointer;
      transition: background-color 0.22s var(--ease-damped), color 0.22s var(--ease-damped), border-color 0.22s var(--ease-damped), transform 0.16s var(--ease-damped);
    }
    .btn:active { transform: translateY(1px); }

    .btn-light {
      background-color: var(--ground);
      color: var(--carbon);
    }
    .btn-carbon {
      background-color: var(--carbon);
      color: var(--ground);
    }
    .btn-signal {
      background-color: var(--signal);
      color: #FFFFFF;
    }
    .btn-outline-dark {
      background-color: transparent;
      color: var(--ink-light);
      border-color: rgba(244, 243, 239, 0.32);
    }
    .btn-outline-light {
      background-color: transparent;
      color: var(--carbon);
      border-color: rgba(17, 17, 17, 0.3);
    }

    @media (hover: hover) {
      .btn-light:hover,
      .btn-carbon:hover {
        background-color: var(--signal);
        color: #FFFFFF;
      }
      .btn-signal:hover {
        background-color: #B81D14;
      }
      .btn-outline-dark:hover {
        border-color: var(--ink-light);
        background-color: rgba(244, 243, 239, 0.08);
      }
      .btn-outline-light:hover {
        border-color: var(--carbon);
        background-color: var(--carbon);
        color: var(--ground);
      }
    }

    /* Kinbo Logo Hover Shift (Hover-Capable Devices Only) */
    .kinbo-logo {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 4px;
      --dot-tx: 0px;
      --dot-ty: 0px;
    }
    .kinbo-logo svg {
      height: 26px;
      width: auto;
      display: block;
    }
    @media (hover: hover) {
      .kinbo-logo:hover {
        --dot-tx: -3.2px;
        --dot-ty: 2px;
      }
    }

    /* =========================================================================
       FLOATING SWISS ISLAND NAVBAR
       ========================================================================= */
    .nav-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      padding: 12px 16px 0;
      pointer-events: none;
    }
    .nav-island {
      pointer-events: auto;
      max-width: var(--container);
      margin-inline: auto;
      min-height: 60px;
      padding: 6px 16px;
      background-color: rgba(17, 17, 17, 0.92);
      border: 1px solid var(--rule-dark);
      border-radius: var(--radius-md);
      box-shadow: 0 16px 40px -16px rgba(0, 0, 0, 0.55);
      color: var(--ink-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      transition: background-color 0.25s var(--ease-damped), border-color 0.25s var(--ease-damped);
    }
    .nav-island.is-scrolled {
      background-color: var(--carbon);
      border-color: rgba(244, 243, 239, 0.24);
    }

    .nav-links {
      display: none;
      align-items: center;
      gap: 8px;
    }
    .nav-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 14px;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--ink-light-muted);
      border-radius: var(--radius-sm);
      transition: color 0.2s var(--ease-damped);
    }
    @media (hover: hover) {
      .nav-links a:hover { color: var(--ink-light); }
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-cta-desktop {
      display: none;
      padding: 10px 18px;
      font-size: 0.875rem;
    }
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      color: var(--ink-light);
      cursor: pointer;
    }
    @media (min-width: 768px) {
      .nav-links { display: flex; }
      .nav-cta-desktop { display: inline-flex; }
      .menu-toggle { display: none; }
    }

    .mobile-drawer {
      pointer-events: auto;
      max-width: var(--container);
      margin: 8px auto 0;
      background-color: var(--carbon);
      border: 1px solid rgba(244, 243, 239, 0.22);
      border-radius: var(--radius-md);
      padding: 16px;
      color: var(--ink-light);
      box-shadow: 0 20px 44px rgba(0, 0, 0, 0.6);
    }
    .mobile-drawer[hidden] { display: none; }
    .mobile-drawer nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .mobile-drawer a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 44px;
      padding: 10px 8px;
      border-bottom: 1px solid var(--rule-dark);
      font-weight: 500;
    }
    .mobile-drawer .btn {
      width: 100%;
      margin-top: 12px;
    }

    /* =========================================================================
       HERO - ORBITAL SUNRISE CANVAS (#050505)
       ========================================================================= */
    .hero {
      position: relative;
      min-height: 100svh;
      background-color: var(--void);
      color: var(--ink-light);
      overflow-x: clip; /* Decorative canvas clip only - never on body */
      overflow-y: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 112px 16px 120px;
      text-align: center;
    }
    .hero-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      pointer-events: none;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 820px;
      margin-top: -48px;
    }
    .hero-title {
      font-size: clamp(2.75rem, 7vw, 5.25rem);
      color: var(--ink-light);
    }
    .hero-subtext {
      margin: 20px auto 0;
      font-size: clamp(1.125rem, 2.2vw, 1.375rem);
      color: rgba(244, 243, 239, 0.88);
      font-weight: 400;
      letter-spacing: -0.01em;
    }
    .hero-actions {
      margin-top: 40px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
    }
    .hero-actions .btn {
      width: 100%;
    }
    @media (min-width: 540px) {
      .hero-actions .btn { width: auto; }
    }
    .hero-scroll-hint {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      display: none;
      align-items: center;
      gap: 10px;
      color: rgba(244, 243, 239, 0.65);
    }
    .hero-scroll-hint .line {
      width: 24px;
      height: 1px;
      background: rgba(244, 243, 239, 0.45);
    }
    @media (min-width: 640px) {
      .hero-scroll-hint { display: flex; }
    }

    /* =========================================================================
       ARCHITECTURAL PHOTOGRAPHY & SCRIMS
       ========================================================================= */
    .arch-fallback {
      background-color: var(--carbon);
      background-image:
        linear-gradient(to right, rgba(244, 243, 239, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(244, 243, 239, 0.05) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .photo-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(100%) contrast(1.08) brightness(0.72);
      transition: transform 0.85s var(--ease-damped), filter 0.55s var(--ease-damped);
    }
    .photo-bg.is-hidden {
      opacity: 0;
    }
    .scrim-spread {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 8, 8, 0.52) 0%, rgba(8, 8, 8, 0.68) 45%, rgba(8, 8, 8, 0.92) 100%);
      pointer-events: none;
    }
    .scrim-card {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 8, 8, 0.22) 0%, rgba(8, 8, 8, 0.48) 50%, rgba(8, 8, 8, 0.93) 100%);
      pointer-events: none;
    }

    /* =========================================================================
       SECTION 01 - DIRECT-TO-ENGINEER FULL-BLEED IMAGE SPREAD + ANSWER-FIRST
       ========================================================================= */
    .spread-direct {
      position: relative;
      min-height: 82svh;
      color: var(--ink-light);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-bottom: 1px solid var(--rule-dark);
    }
    .spread-direct-inner {
      position: relative;
      z-index: 2;
      padding-block: 72px 56px;
      display: flex;
      flex-direction: column;
      gap: 40px;
    }
    @media (min-width: 1024px) {
      .spread-direct-inner { padding-block: 96px 72px; }
    }
    .spread-headline {
      font-size: clamp(2.125rem, 5vw, 4rem);
      max-width: 960px;
      color: var(--ink-light);
    }
    .answer-island {
      background-color: rgba(17, 17, 17, 0.88);
      border: 1px solid var(--rule-dark);
      border-left: 3px solid var(--signal);
      border-radius: var(--radius-md);
      padding: 24px 28px;
      max-width: 780px;
    }
    .answer-island p {
      margin: 8px 0 0;
      font-size: 1rem;
      line-height: 1.65;
      color: rgba(244, 243, 239, 0.9);
    }
    .spread-strip {
      position: relative;
      z-index: 2;
      border-top: 1px solid var(--rule-dark);
      background-color: rgba(5, 5, 5, 0.72);
    }
    .spread-strip-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
      padding-block: 22px;
    }
    @media (min-width: 768px) {
      .spread-strip-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    }
    .strip-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-light);
    }
    .strip-dot {
      width: 6px;
      height: 6px;
      background-color: var(--signal-dark-bg);
      flex-shrink: 0;
    }

    /* =========================================================================
       SECTION HEADER SHARED
       ========================================================================= */
    .sec-head {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 48px;
    }
    @media (min-width: 1024px) {
      .sec-head {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
      }
    }
    .sec-title {
      font-size: clamp(2rem, 4.2vw, 3.125rem);
      margin-top: 8px;
    }
    .sec-lead {
      margin: 0;
      max-width: 420px;
      color: var(--ink-dark-muted);
      font-size: 1rem;
    }

    /* =========================================================================
       SECTION 02 - 5-COLUMN INTERACTIVE SERVICES EXPLORER
       ========================================================================= */
    .island-light {
      background-color: var(--surface);
      border: 1px solid var(--rule-light);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .services-cols {
      display: grid;
      grid-template-columns: 1fr;
      border-bottom: 1px solid var(--rule-light);
    }
    @media (min-width: 640px) {
      .services-cols { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .services-cols { grid-template-columns: repeat(5, 1fr); }
    }
    .svc-col {
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
      border-bottom: 1px solid var(--rule-light);
      background-color: var(--surface);
    }
    @media (min-width: 640px) {
      .svc-col { border-right: 1px solid var(--rule-light); }
    }
    @media (min-width: 1024px) {
      .svc-col { border-bottom: 0; }
      .svc-col:last-child { border-right: 0; }
    }
    .svc-col h3 {
      margin: 6px 0 0;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .svc-tracks {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .svc-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 44px;
      padding: 10px 14px;
      background-color: var(--surface);
      border: 1px solid var(--rule-light);
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--carbon);
      cursor: pointer;
      transition: background-color 0.2s var(--ease-damped), color 0.2s var(--ease-damped), border-color 0.2s var(--ease-damped);
    }
    .svc-trigger .arrow {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      transition: transform 0.2s var(--ease-damped);
    }
    .svc-trigger.is-active {
      background-color: var(--carbon);
      color: var(--ink-light);
      border-color: var(--carbon);
    }
    .svc-trigger.is-active .arrow {
      color: var(--signal-dark-bg);
      transform: translateX(3px);
    }
    @media (hover: hover) {
      .svc-trigger:not(.is-active):hover {
        border-color: var(--carbon);
      }
    }

    .svc-subpanel {
      background-color: #F9F8F5;
      padding: 28px 20px;
    }
    @media (min-width: 1024px) {
      .svc-subpanel { padding: 36px 32px; }
    }
    .svc-cards-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 16px;
    }
    @media (min-width: 640px) {
      .svc-cards-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .svc-cards-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .svc-item-btn {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      min-height: 76px;
      padding: 16px;
      background-color: var(--surface);
      border: 1px solid var(--rule-light);
      border-radius: 6px;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.2s var(--ease-damped), transform 0.2s var(--ease-damped);
    }
    @media (hover: hover) {
      .svc-item-btn:hover {
        border-color: var(--carbon);
        transform: translateY(-1px);
      }
    }
    .svc-thumb {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      border-radius: var(--radius-sm);
      background-color: var(--carbon);
      border: 1px solid rgba(17, 17, 17, 0.14);
    }
    .svc-item-title {
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--carbon);
    }
    .svc-item-desc {
      margin: 2px 0 0;
      font-size: 0.875rem;
      color: var(--ink-dark-muted);
      line-height: 1.4;
    }

    /* =========================================================================
       SECTION 03 - CROSS-DISCIPLINE EDITORIAL BENTO (IMAGE-ON-TEXT)
       ========================================================================= */
    .bento-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    @media (min-width: 768px) {
      .bento-grid { grid-template-columns: repeat(12, 1fr); }
      .bento-wide { grid-column: span 7; }
      .bento-narrow { grid-column: span 5; }
    }
    .bento-card {
      position: relative;
      min-height: 360px;
      border-radius: var(--radius-md);
      overflow: hidden;
      padding: 32px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: var(--ink-light);
    }
    @media (min-width: 1024px) {
      .bento-card { min-height: 410px; padding: 40px; }
    }
    @media (hover: hover) {
      .bento-card:hover .photo-bg {
        transform: scale(1.04);
        filter: grayscale(85%) contrast(1.12) brightness(0.8);
      }
    }
    .bento-body {
      position: relative;
      z-index: 2;
      max-width: 460px;
    }
    .bento-body h3 {
      margin: 0;
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }
    .bento-body p {
      margin: 10px 0 0;
      font-size: 0.9375rem;
      color: rgba(244, 243, 239, 0.85);
    }

    /* =========================================================================
       SECTION 04 - PROCESS & LIFELONG SUPPORT* SPREAD (DARK #111111)
       ========================================================================= */
    .process-section {
      background-color: var(--carbon);
      color: var(--ink-light);
      border-top: 1px solid var(--rule-dark);
      border-bottom: 1px solid var(--rule-dark);
    }
    .process-split {
      max-width: 1440px;
      margin-inline: auto;
      display: grid;
      grid-template-columns: 1fr;
    }
    @media (min-width: 1024px) {
      .process-split { grid-template-columns: 5fr 7fr; }
    }
    .process-photo-col {
      position: relative;
      min-height: 360px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 40px 28px;
    }
    @media (min-width: 1024px) {
      .process-photo-col { min-height: 680px; padding: 56px 48px; }
    }
    .process-stages-col {
      padding: 48px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 40px;
    }
    @media (min-width: 1024px) {
      .process-stages-col { padding: 64px 64px; }
    }
    .stage-item {
      padding-block: 28px;
      border-bottom: 1px solid var(--rule-dark);
    }
    .stage-item:first-child { padding-top: 0; }
    .stage-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .stage-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .stage-item h3 {
      margin: 0;
      font-size: clamp(1.375rem, 2.4vw, 1.75rem);
      font-weight: 700;
      letter-spacing: -0.025em;
    }
    .stage-item p {
      margin: 8px 0 0;
      color: var(--ink-light-muted);
      max-width: 560px;
    }
    .support-box {
      border-left: 3px solid var(--signal);
      background-color: var(--dark-surface);
      padding: 20px 24px;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
    .support-box p {
      margin: 6px 0 0;
      font-size: 0.9375rem;
      color: var(--ink-light-muted);
    }

    /* =========================================================================
       SECTION 05 - TRANSPARENT RATE CARDS & 3-CLICK SCOPE ESTIMATOR
       ========================================================================= */
    .currency-toggle {
      display: inline-flex;
      background-color: var(--surface);
      border: 1px solid var(--rule-light);
      border-radius: 6px;
      padding: 4px;
      gap: 4px;
    }
    .curr-btn {
      min-height: 44px;
      min-width: 78px;
      padding: 8px 14px;
      border: 0;
      border-radius: var(--radius-sm);
      background: transparent;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--ink-dark-muted);
      cursor: pointer;
    }
    .curr-btn.is-active {
      background-color: var(--carbon);
      color: var(--ink-light);
    }

    .rates-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .rates-grid { grid-template-columns: 7fr 5fr; }
    }

    .rate-tabs {
      display: flex;
      overflow-x: auto;
      gap: 6px;
      padding: 10px;
      background-color: #F9F8F5;
      border-bottom: 1px solid var(--rule-light);
    }
    .rate-tab {
      min-height: 44px;
      padding: 10px 14px;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      background: transparent;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
      color: var(--ink-dark-muted);
      cursor: pointer;
    }
    .rate-tab.is-active {
      background-color: var(--carbon);
      color: var(--ink-light);
    }
    .rate-panel {
      padding: 28px 24px;
    }
    @media (min-width: 640px) {
      .rate-panel { padding: 32px; }
    }
    .rate-panel-head {
      padding-bottom: 16px;
      border-bottom: 1px solid var(--rule-light);
    }
    .rate-panel-head h3 {
      margin: 0;
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .rate-panel-head p {
      margin: 4px 0 0;
      font-size: 0.9375rem;
      color: var(--ink-dark-muted);
    }
    .rate-list {
      margin-top: 4px;
    }
    .rate-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      width: 100%;
      min-height: 68px;
      padding: 16px 8px;
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--rule-light);
      text-align: left;
      cursor: pointer;
      transition: background-color 0.2s var(--ease-damped), padding-left 0.22s var(--ease-damped);
    }
    .rate-row:last-child { border-bottom: 0; }
    @media (hover: hover) {
      .rate-row:hover {
        background-color: var(--ground);
        padding-left: 14px;
      }
    }
    .rate-name {
      font-size: 1rem;
      font-weight: 600;
      color: var(--carbon);
    }
    .rate-desc {
      margin-top: 2px;
      font-size: 0.875rem;
      color: var(--ink-dark-muted);
    }
    .rate-price-col {
      text-align: right;
      flex-shrink: 0;
    }
    .rate-price {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 700;
      color: var(--carbon);
    }
    .rate-price.is-accent { color: var(--signal-light-bg); }
    .rate-subtag {
      margin-top: 2px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-dark-muted);
    }
    .rate-footnote {
      padding: 16px 24px;
      background-color: #F9F8F5;
      border-top: 1px solid var(--rule-light);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-dark-muted);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
    }

    /* 3-Click Scope Estimator Island */
    .estimator-island {
      background-color: var(--carbon);
      color: var(--ink-light);
      border: 1px solid var(--carbon);
      border-radius: var(--radius-md);
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    @media (min-width: 640px) {
      .estimator-island { padding: 32px; }
    }
    .est-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--rule-dark);
    }
    .est-field label {
      display: block;
      margin-bottom: 8px;
      color: var(--ink-light-muted);
    }
    .est-select {
      width: 100%;
      min-height: 44px;
      padding: 10px 14px;
      background-color: var(--dark-surface);
      border: 1px solid rgba(244, 243, 239, 0.24);
      border-radius: var(--radius-sm);
      color: var(--ink-light);
      font-size: 0.9375rem;
      cursor: pointer;
    }
    .pace-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .pace-btn {
      min-height: 44px;
      padding: 10px 12px;
      background-color: var(--dark-surface);
      border: 1px solid rgba(244, 243, 239, 0.22);
      border-radius: var(--radius-sm);
      color: var(--ink-light-muted);
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
    }
    .pace-btn.is-active {
      background-color: var(--ground);
      color: var(--carbon);
      border-color: var(--ground);
      font-weight: 600;
    }
    .est-output {
      padding-top: 20px;
      border-top: 1px solid var(--rule-dark);
    }
    .est-total {
      font-family: var(--font-mono);
      font-size: clamp(2rem, 4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-top: 4px;
      color: var(--ink-light);
    }
    .milestone-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 16px;
    }
    .milestone-grid[hidden] { display: none; }
    .milestone-box {
      background-color: var(--dark-surface);
      border: 1px solid var(--rule-dark);
      border-radius: var(--radius-sm);
      padding: 10px 6px;
      text-align: center;
    }
    .milestone-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-light-muted);
    }
    .milestone-val {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      font-weight: 700;
      margin-top: 4px;
    }
    .milestone-val.is-final { color: var(--signal-dark-bg); }
    .est-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* =========================================================================
       SECTION 06 - TECHNICAL FAQ ACCORDION
       ========================================================================= */
    .faq-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
    }
    @media (min-width: 1024px) {
      .faq-grid { grid-template-columns: 4fr 8fr; }
    }
    .faq-list {
      padding: 8px 24px;
    }
    @media (min-width: 640px) {
      .faq-list { padding: 12px 32px; }
    }
    .faq-item {
      border-bottom: 1px solid var(--rule-light);
    }
    .faq-item:last-child { border-bottom: 0; }
    .faq-trigger {
      width: 100%;
      min-height: 56px;
      padding: 18px 0;
      background: transparent;
      border: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      text-align: left;
      font-size: 1rem;
      font-weight: 600;
      color: var(--carbon);
      cursor: pointer;
    }
    .faq-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 28px;
      min-height: 28px;
      font-family: var(--font-mono);
      font-size: 1.375rem;
      line-height: 1;
      transition: transform 0.28s var(--ease-damped);
    }
    .faq-item[data-open="true"] .faq-icon {
      transform: rotate(45deg);
    }
    .faq-panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.32s var(--ease-damped);
    }
    .faq-item[data-open="true"] .faq-panel {
      grid-template-rows: 1fr;
    }
    .faq-panel-inner {
      overflow: hidden;
    }
    .faq-panel-inner p {
      margin: 0 0 20px;
      color: var(--ink-dark-muted);
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    /* =========================================================================
       SECTION 07 - CLOSING IMAGE SPREAD & 5-COLUMN SWISS FOOTER
       ========================================================================= */
    .closing-spread {
      position: relative;
      min-height: 60svh;
      color: var(--ink-light);
      overflow: hidden;
      display: flex;
      align-items: center;
    }
    .closing-inner {
      position: relative;
      z-index: 2;
      padding-block: 88px;
    }
    .closing-logo svg {
      height: 44px;
      width: auto;
      display: block;
      margin-bottom: 28px;
    }
    .closing-actions {
      margin-top: 36px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .site-footer {
      background-color: var(--carbon);
      color: var(--ink-light);
      border-top: 1px solid var(--rule-dark);
      padding-bottom: 84px; /* Clearance for sticky mobile bar */
    }
    @media (min-width: 768px) {
      .site-footer { padding-bottom: 0; }
    }
    .footer-grid {
      padding-block: 56px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 36px 24px;
    }
    @media (min-width: 1024px) {
      .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr; }
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    @media (min-width: 1024px) {
      .footer-brand-col { grid-column: span 1; }
    }
    .bo-badge svg {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-md);
      border: 1px solid var(--rule-dark);
      display: block;
    }
    .status-pill {
      margin-top: 16px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-light-muted);
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--signal-dark-bg);
    }
    .footer-col h3 {
      margin: 0 0 14px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(244, 243, 239, 0.6);
    }
    .footer-col ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .footer-col a,
    .footer-col button {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      font-size: 0.875rem;
      color: var(--ink-light-muted);
      background: transparent;
      border: 0;
      padding: 4px 0;
      cursor: pointer;
    }
    @media (hover: hover) {
      .footer-col a:hover,
      .footer-col button:hover {
        color: var(--ink-light);
      }
    }
    .footer-bottom {
      border-top: 1px solid var(--rule-dark);
      padding-block: 20px;
    }
    .footer-bottom-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: rgba(244, 243, 239, 0.6);
    }

    /* =========================================================================
       STICKY MOBILE BOTTOM ISLAND (< 768px)
       ========================================================================= */
    .mobile-bar {
      position: fixed;
      bottom: 12px;
      left: 12px;
      right: 12px;
      z-index: 45;
      background-color: var(--carbon);
      border: 1px solid rgba(244, 243, 239, 0.24);
      border-radius: var(--radius-md);
      padding: 6px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.6);
    }
    .mobile-bar a {
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .mobile-bar .mb-est {
      background-color: var(--dark-surface);
      color: var(--ink-light);
      border: 1px solid var(--rule-dark);
    }
    .mobile-bar .mb-wa {
      background-color: var(--signal);
      color: #FFFFFF;
    }
    @media (min-width: 768px) {
      .mobile-bar { display: none; }
    }

    /* =========================================================================
       DIRECT-TO-ENGINEER MODAL (WITH FULL FOCUS TRAP)
       ========================================================================= */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 60;
      background-color: rgba(5, 5, 5, 0.82);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.24s var(--ease-damped);
    }
    .modal-backdrop.is-open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-panel {
      width: 100%;
      max-width: 500px;
      max-height: 92svh;
      overflow-y: auto;
      background-color: var(--ground);
      color: var(--carbon);
      border: 1px solid var(--carbon);
      border-radius: var(--radius-md);
      transform: translateY(14px);
      transition: transform 0.28s var(--ease-damped);
    }
    .modal-backdrop.is-open .modal-panel {
      transform: translateY(0);
    }
    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 18px 24px;
      background-color: var(--surface);
      border-bottom: 1px solid var(--rule-light);
    }
    .modal-head h3 {
      margin: 4px 0 0;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .modal-close {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--rule-light);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 1.375rem;
      line-height: 1;
      color: var(--carbon);
      cursor: pointer;
    }
    .modal-body {
      padding: 24px;
    }
    .form-field {
      margin-bottom: 16px;
    }
    .form-field label {
      display: block;
      margin-bottom: 6px;
      color: var(--ink-dark-muted);
    }
    .form-input {
      width: 100%;
      min-height: 44px;
      padding: 10px 14px;
      background-color: var(--surface);
      border: 1px solid rgba(17, 17, 17, 0.24);
      border-radius: var(--radius-sm);
      font-size: 0.9375rem;
      color: var(--carbon);
    }
    .form-error {
      margin: 0 0 14px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--signal-light-bg);
    }
    .form-error[hidden] { display: none; }
    .modal-foot-row {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-dark-muted);
    }
    .modal-wa-link {
      color: var(--signal-light-bg);
      font-weight: 600;
      text-transform: uppercase;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .modal-confirm {
      padding: 36px 24px;
      text-align: center;
    }
    .modal-confirm[hidden],
    .modal-body[hidden] { display: none; }
    .confirm-check {
      width: 48px;
      height: 48px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background-color: var(--signal);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 1.25rem;
