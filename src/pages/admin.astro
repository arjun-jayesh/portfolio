---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import AdminInterface from "../components/AdminInterface";
import {
  createAdminSessionToken,
  verifyAdminSessionToken,
  verifyPassword,
  checkLoginLockout,
  recordLoginFailure,
  resetLoginLockout,
  createCsrfToken,
} from "../lib/auth";

const clientIp =
  Astro.request.headers.get("cf-connecting-ip") ||
  Astro.request.headers.get("x-real-ip") ||
  Astro.request.headers.get("x-forwarded-for")?.split(",")[0]?.trim() ||
  "unknown";

const existingToken = Astro.cookies.get("admin_session")?.value;
let isAuthenticated = await verifyAdminSessionToken(existingToken);
let error = "";
let csrfToken = existingToken ? await createCsrfToken(existingToken) : "";

if (Astro.request.method === "POST") {
  const lockout = checkLoginLockout(clientIp);
  if (lockout.isLocked) {
    const mins = Math.ceil(lockout.remainingMs / 60000);
    error = `Too many failed attempts. Login locked for ${mins} minute(s).`;
  } else {
    const data = await Astro.request.formData();
    const submittedPassword = String(data.get("password") ?? "");

    const isMatch = await verifyPassword(submittedPassword);

    if (isMatch) {
      resetLoginLockout(clientIp);
      const signedToken = await createAdminSessionToken();
      Astro.cookies.set("admin_session", signedToken, {
        path: "/",
        httpOnly: true,
        secure: import.meta.env.PROD,
        sameSite: "strict",
        maxAge: 60 * 60 * 24,
      });
      isAuthenticated = true;
      csrfToken = await createCsrfToken(signedToken);
    } else {
      recordLoginFailure(clientIp);
      const updated = checkLoginLockout(clientIp);
      if (updated.isLocked) {
        error = "Maximum attempts exceeded. IP locked out for 15 minutes.";
      } else {
        error = "Invalid connection key.";
      }
    }
  }
}
---

<Layout title="Command Center - KINBO Admin Portal" hideHeaderFooter={true}>
  {isAuthenticated ? (
    <div class="pt-16 pb-24 px-4 sm:px-8 max-w-7xl mx-auto">
      <AdminInterface client:only="preact" csrfToken={csrfToken} />
    </div>
  ) : (
    <div class="min-h-screen flex items-center justify-center p-4 bg-[#050505]">
      <div class="w-full max-w-md p-8 bg-[#111111] border border-[rgba(244,243,239,0.16)] rounded-[8px] shadow-2xl relative">
        <div class="font-mono text-xs text-[#FF5A52] uppercase mb-1">
          00 // ROOT AUTHENTICATION
        </div>
        <h1 class="text-2xl font-bold text-white tracking-tight mb-2">
          Systems Command Center
        </h1>
        <p class="text-xs text-[rgba(244,243,239,0.7)] mb-6">
          Authenticated administrative access for site configuration, redirects, and content registries.
        </p>

        {error && (
          <div class="mb-4 p-3 bg-[#D9261C]/15 border border-[#D9261C] text-[#FF5A52] font-mono text-xs rounded-[4px] text-center" role="alert">
            {error}
          </div>
        )}

        <form method="POST" data-astro-reload class="space-y-4">
          <div>
            <label for="password" class="block font-mono text-[12px] text-[rgba(244,243,239,0.75)] uppercase mb-1.5">
              Master Connection Key
            </label>
            <input
              type="password"
              id="password"
              name="password"
              autocomplete="current-password"
              class="w-full touch-target bg-[#181818] border border-[rgba(244,243,239,0.16)] rounded-[4px] px-3.5 py-2.5 text-sm text-[#F4F3EF] font-mono focus:border-[#FF5A52] focus:outline-none"
              placeholder="••••••••••••"
              required
            />
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full touch-target bg-[#D9261C] hover:bg-[#B81D14] text-white font-mono text-xs font-semibold uppercase tracking-wider rounded-[4px] px-4 py-3 transition-colors cursor-pointer"
            >
              [ Establish Authenticated Session ]
            </button>
          </div>
        </form>
      </div>
    </div>
  )}
</Layout>
