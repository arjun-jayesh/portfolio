---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Works from "../components/Works.astro";
import { supabaseAdmin } from "../lib/supabase";

let founderPhoto = "/arjun-portrait.png";
if (supabaseAdmin) {
  try {
    const { data } = await supabaseAdmin
      .from("site_config")
      .select("data")
      .eq("key", "enterprise_assets")
      .maybeSingle();
    if (data?.data?.founder_photo_url) {
      founderPhoto = data.data.founder_photo_url;
    }
  } catch (e) {
    console.error("Founder SSR lookup error:", e);
  }
}
---

<Layout
  title="Arjun Jayesh - Founder & Systems Architect | KINBO"
  description="Arjun Jayesh is a Systems Architect and Developer directing KINBO Technologies Private Limited across India, China, and GCC."
  image={founderPhoto}
  schemaType="AboutPage"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-32 pb-24">
    {/* Breadcrumbs */}
    <div class="font-mono text-[12px] uppercase tracking-wider text-[#FF5A52] mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-white transition-colors">HOME</a>
      <span class="text-[rgba(244,243,239,0.3)]">/</span>
      <span class="text-white">FOUNDER</span>
    </div>

    {/* Masthead: Swiss Split Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start pb-16 border-b border-[rgba(244,243,239,0.14)]">
      {/* Bio Details */}
      <div class="lg:col-span-7 space-y-6">
        <div>
          <div class="font-mono text-xs text-[#FF5A52] uppercase mb-1">
            PRINCIPAL ARCHITECT · FOUNDER
          </div>
          <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-[#FFFFFF]">
            Arjun Jayesh
          </h1>
          <p class="font-mono text-xs text-[rgba(244,243,239,0.6)] mt-2">
            RESEARCHER // DEVELOPER // FOUNDER @ KINBO TECHNOLOGIES
          </p>
        </div>

        <p class="text-base sm:text-lg text-[rgba(244,243,239,0.85)] leading-relaxed">
          Building deterministic computing architectures, healthcare queue orchestration engines (QueueZero™), and enterprise software systems across India, China, and the GCC.
        </p>

        <p class="text-sm text-[rgba(244,243,239,0.72)] leading-relaxed">
          "Software systems must be engineered as deterministic physical mechanisms: provable state transitions, zero superfluous dependencies, and complete code ownership in the hands of the client from day one."
        </p>

        {/* Technical Core Specialties */}
        <div class="p-5 bg-[#111111] border border-[rgba(244,243,239,0.12)] rounded-[6px]">
          <div class="font-mono text-[12px] text-[#FF5A52] uppercase mb-2">Technical Disciplines</div>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 bg-[#181818] rounded text-xs font-mono text-[rgba(244,243,239,0.8)] border border-[rgba(244,243,239,0.1)]">Distributed Systems</span>
            <span class="px-2.5 py-1 bg-[#181818] rounded text-xs font-mono text-[rgba(244,243,239,0.8)] border border-[rgba(244,243,239,0.1)]">Deterministic Scheduling</span>
            <span class="px-2.5 py-1 bg-[#181818] rounded text-xs font-mono text-[rgba(244,243,239,0.8)] border border-[rgba(244,243,239,0.1)]">Computer Vision (OpenCV/Rust)</span>
            <span class="px-2.5 py-1 bg-[#181818] rounded text-xs font-mono text-[rgba(244,243,239,0.8)] border border-[rgba(244,243,239,0.1)]">FastAPI / Node SSR</span>
            <span class="px-2.5 py-1 bg-[#181818] rounded text-xs font-mono text-[rgba(244,243,239,0.8)] border border-[rgba(244,243,239,0.1)]">Healthcare Informatics</span>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-open-modal="engineer"
            data-goal="Technical Architecture Advisory with Founder"
            class="touch-target px-5 py-2.5 bg-[#D9261C] hover:bg-[#B81D14] text-white text-xs font-semibold rounded-[4px] transition-colors inline-flex items-center gap-2"
          >
            <span>Talk to Arjun Directly</span>
            <span class="font-mono">→</span>
          </button>
          <a
            href="https://github.com/arjun-jayesh"
            target="_blank"
            rel="noopener noreferrer"
            class="touch-target px-5 py-2.5 bg-[#181818] hover:bg-[#222222] border border-[rgba(244,243,239,0.14)] text-xs font-mono text-[#F4F3EF] rounded-[4px] transition-colors"
          >
            GitHub Dossier ↗
          </a>
        </div>
      </div>

      {/* Portrait & Telemetry */}
      <div class="lg:col-span-5 bg-[#111111] border border-[rgba(244,243,239,0.14)] rounded-[8px] p-6 text-center">
        <div class="w-48 h-48 sm:w-56 sm:h-56 mx-auto rounded-full overflow-hidden border-2 border-[#D9261C] bg-[#181818] mb-5">
          <img
            src={founderPhoto}
            alt="Arjun Jayesh"
            width="224"
            height="224"
            class="w-full h-full object-cover grayscale contrast-125"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="font-mono text-sm font-semibold text-white">ARJUN JAYESH</div>
        <div class="font-mono text-xs text-[#FF5A52] mt-0.5">DIRECT ENGINEERING CONTACT</div>
        <div class="mt-4 pt-4 border-t border-[rgba(244,243,239,0.1)] font-mono text-xs text-[rgba(244,243,239,0.6)] space-y-1 text-left">
          <div>LOCATIONS: KOCHI · BANGALORE · SHENZHEN</div>
          <div>STATUS: AVAILABLE FOR ARCHITECTURE REVIEWS</div>
          <div>OWNERSHIP: ZERO SALES INTERMEDIARIES</div>
        </div>
      </div>
    </div>

    {/* Selected Works Timeline */}
    <Works />
  </div>
</Layout>
