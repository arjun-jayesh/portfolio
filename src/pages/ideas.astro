---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import IdeasForm from "../components/IdeasForm";
---

<Layout
  title="RFP & Engineering Estimator — KINBO | 01 SIGNAL"
  description="Submit your software project specification directly to KINBO's engineering desk. Zero sales reps, direct technical feasibility review."
  schemaType="ContactPage"
>
  <div class="max-w-4xl mx-auto px-5 sm:px-8 pt-32 pb-24">
    {/* Breadcrumbs */}
    <div class="font-mono text-[12px] uppercase tracking-wider text-[#FF5A52] mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-white transition-colors">HOME</a>
      <span class="text-[rgba(244,243,239,0.3)]">/</span>
      <span class="text-white">RFP ESTIMATOR</span>
    </div>

    {/* Form Component */}
    <IdeasForm client:load />
  </div>
</Layout>
