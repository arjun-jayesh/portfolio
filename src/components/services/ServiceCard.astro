---
interface Props {
  index?: string;
  title: string;
  division: string;
  description: string;
  deliverables: string[];
  engagementModel?: string;
  href: string;
}

const {
  index = "01",
  title,
  division,
  description,
  deliverables = [],
  engagementModel = "SLA RETAINER / FIXED SCOPE",
  href,
} = Astro.props;
---

<article class="border border-offwhite/15 bg-charcoal-light/20 rounded-sm flex flex-col justify-between hover:border-teal transition-colors group">
  <div>
    {/* Top Telemetry Header */}
    <div class="px-5 py-3 border-b border-offwhite/10 bg-charcoal-dark/50 flex items-center justify-between font-mono text-[10px] uppercase tracking-widest">
      <span class="text-teal font-semibold">DIV //{index} // {division}</span>
      <span class="text-muted">{engagementModel}</span>
    </div>

    {/* Body Content */}
    <div class="p-6 sm:p-7 space-y-4">
      <h3 class="font-display text-3xl sm:text-4xl text-offwhite leading-tight group-hover:text-teal transition-colors">
        {title}
      </h3>
      <p class="font-lora text-sm text-muted leading-relaxed">
        {description}
      </p>

      {deliverables.length > 0 && (
        <div class="pt-4 border-t border-offwhite/10 space-y-2">
          <div class="font-mono text-[10px] uppercase tracking-widest text-muted">
            ARCHITECTURAL DELIVERABLES:
          </div>
          <ul class="space-y-2 font-mono text-xs text-offwhite/90">
            {deliverables.map((item, i) => (
              <li class="flex items-start gap-2.5">
                <span class="text-teal text-[10px] mt-0.5 tabular-nums">
                  0{i + 1}.
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>

  {/* Bottom Action Footer */}
  <div class="px-6 py-4 border-t border-offwhite/10 bg-charcoal-dark/30 flex items-center justify-between">
    <span class="font-mono text-[10px] uppercase tracking-widest text-muted">
      DIRECT PRINCIPAL ENGAGEMENT
    </span>
    <a
      href={href}
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-teal font-semibold group-hover:translate-x-1 transition-transform"
    >
      <span>Inspect Division</span>
      <span>&rarr;</span>
    </a>
  </div>
</article>
