---
---
<section class="relative w-full min-h-[92vh] flex flex-col justify-end pb-16 sm:pb-24 pt-28 px-5 sm:px-8 bg-[#050505] overflow-x-clip border-b border-[rgba(244,243,239,0.12)]">
  {/* High-DPR Orbital Canvas */}
  <canvas
    id="orbital-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none z-0"
    aria-hidden="true"
  ></canvas>

  {/* Hero Content Overlay */}
  <div class="relative z-10 max-w-5xl mx-auto w-full">
    <div class="font-mono text-[12px] sm:text-xs uppercase tracking-widest text-[#FF5A52] mb-3 flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[#D9261C]"></span>
      <span>00 / KINBO TECHNOLOGIES · 01 SIGNAL</span>
    </div>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-[-0.035em] text-[#FFFFFF] max-w-3xl leading-[1.08]">
      You deserve the best.<span class="sr-only"> — Custom Software Engineering by kinbo</span>
    </h1>

    <p class="text-lg sm:text-xl text-[rgba(244,243,239,0.85)] mt-4 max-w-xl font-normal leading-relaxed">
      We at kinbo care about you.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="#services"
        class="touch-target px-6 py-3 bg-[#F4F3EF] hover:bg-white text-[#111111] text-sm font-semibold rounded-[4px] transition-colors inline-flex items-center gap-2 shadow-lg"
      >
        <span>Explore Services</span>
        <span class="font-mono text-xs">↓</span>
      </a>

      <button
        type="button"
        data-open-modal="engineer"
        class="touch-target px-6 py-3 bg-[#D9261C] hover:bg-[#B81D14] text-white text-sm font-semibold rounded-[4px] transition-colors inline-flex items-center gap-2 shadow-lg"
      >
        <span>Talk to an Engineer</span>
        <span class="font-mono text-xs">→</span>
      </button>
    </div>

    {/* Direct Access Telemetry strip */}
    <div class="mt-14 pt-6 border-t border-[rgba(244,243,239,0.12)] flex flex-wrap items-center justify-between gap-4 font-mono text-[12px] text-[rgba(244,243,239,0.6)]">
      <div>ZERO SALES TEAM · DIRECT ACCESS MODEL</div>
      <div>100% DAY-1 REPO OWNERSHIP</div>
      <div>SSR STANDALONE ARCHITECTURE</div>
    </div>
  </div>
</section>

<script>
  function initOrbitalCanvas() {
    const canvas = document.getElementById('orbital-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animId: number | null = null;
    let isVisible = true;
    let width = 0;
    let height = 0;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // City lights on horizon
    const cityLights: Array<{ x: number; yOffset: number; radius: number; phase: number; speed: number; alpha: number }> = [];
    const numLights = 48;

    function resize() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.parentElement?.clientWidth || window.innerWidth;
      height = canvas.parentElement?.clientHeight || window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Re-seed lights along curved horizon
      cityLights.length = 0;
      for (let i = 0; i < numLights; i++) {
        cityLights.push({
          x: Math.random() * width,
          yOffset: (Math.random() - 0.5) * 26,
          radius: Math.random() * 1.5 + 0.6,
          phase: Math.random() * Math.PI * 2,
          speed: 0.015 + Math.random() * 0.025,
          alpha: Math.random() * 0.6 + 0.3
        });
      }
    }

    let t = 0;

    function renderFrame() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Planetary Horizon parameters
      const horizonY = height * 0.76;
      const curveHeight = height * 0.12;

      // 1. Atmosphere Bloom: Amber to Signal Red (#D9261C)
      const sunX = width * 0.55;
      const sunY = horizonY - 10;

      const bloomGradient = ctx.createRadialGradient(
        sunX, sunY, 10,
        sunX, sunY, width * 0.65
      );
      bloomGradient.addColorStop(0, 'rgba(255, 253, 245, 0.45)');
      bloomGradient.addColorStop(0.15, 'rgba(224, 138, 46, 0.28)');
      bloomGradient.addColorStop(0.4, 'rgba(217, 38, 28, 0.14)');
      bloomGradient.addColorStop(0.85, 'rgba(5, 5, 5, 0)');

      ctx.fillStyle = bloomGradient;
      ctx.fillRect(0, 0, width, height);

      // 2. Anamorphic Horizontal Flare
      const flareGrad = ctx.createLinearGradient(sunX - width * 0.4, sunY, sunX + width * 0.4, sunY);
      flareGrad.addColorStop(0, 'rgba(255, 253, 245, 0)');
      flareGrad.addColorStop(0.48, 'rgba(255, 253, 245, 0.5)');
      flareGrad.addColorStop(0.5, 'rgba(255, 255, 255, 0.95)');
      flareGrad.addColorStop(0.52, 'rgba(255, 253, 245, 0.5)');
      flareGrad.addColorStop(1, 'rgba(255, 253, 245, 0)');

      ctx.fillStyle = flareGrad;
      ctx.fillRect(sunX - width * 0.4, sunY - 1.2, width * 0.8, 2.4);

      // 3. Solar Core (#FFFDF5)
      const coreGrad = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, 18);
      coreGrad.addColorStop(0, '#FFFFFF');
      coreGrad.addColorStop(0.4, '#FFFDF5');
      coreGrad.addColorStop(0.8, 'rgba(224, 138, 46, 0.6)');
      coreGrad.addColorStop(1, 'rgba(217, 38, 28, 0)');

      ctx.fillStyle = coreGrad;
      ctx.beginPath();
      ctx.arc(sunX, sunY, 18, 0, Math.PI * 2);
      ctx.fill();

      // 4. Curved Planetary Horizon
      ctx.beginPath();
      ctx.moveTo(0, horizonY);
      ctx.quadraticCurveTo(width * 0.5, horizonY - curveHeight, width, horizonY);
      ctx.lineTo(width, height);
      ctx.lineTo(0, height);
      ctx.closePath();

      // Planetary surface fill: deep carbon to void
      const planetGrad = ctx.createLinearGradient(0, horizonY - curveHeight, 0, height);
      planetGrad.addColorStop(0, '#0C0C0C');
      planetGrad.addColorStop(0.4, '#080808');
      planetGrad.addColorStop(1, '#050505');
      ctx.fillStyle = planetGrad;
      ctx.fill();

      // Horizon rim stroke
      ctx.lineWidth = 1.2;
      const rimGrad = ctx.createLinearGradient(0, 0, width, 0);
      rimGrad.addColorStop(0, 'rgba(244, 243, 239, 0.08)');
      rimGrad.addColorStop(0.5, 'rgba(255, 253, 245, 0.65)');
      rimGrad.addColorStop(1, 'rgba(244, 243, 239, 0.08)');
      ctx.strokeStyle = rimGrad;
      ctx.stroke();

      // 5. Softly Twinkling Orbital City Lights
      for (let i = 0; i < cityLights.length; i++) {
        const light = cityLights[i];
        // Calculate Y on the curve
        const normX = light.x / width;
        const curveOffset = Math.sin(normX * Math.PI) * curveHeight;
        const ly = horizonY - curveOffset + Math.abs(light.yOffset) + 8;

        if (ly < height) {
          const currentAlpha = prefersReducedMotion
            ? light.alpha
            : Math.max(0.1, Math.min(1, light.alpha + Math.sin(t * light.speed + light.phase) * 0.3));

          ctx.fillStyle = `rgba(255, 235, 180, ${currentAlpha.toFixed(2)})`;
          ctx.beginPath();
          ctx.arc(light.x, ly, light.radius, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function animate() {
      if (!isVisible) return;
      t += 1;
      renderFrame();
      animId = requestAnimationFrame(animate);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (prefersReducedMotion) {
      renderFrame();
    } else {
      animate();
    }

    // CPU Discipline: Pause when offscreen or document hidden
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting && !document.hidden;
          if (isVisible && !prefersReducedMotion && !animId) {
            animate();
          } else if (!isVisible && animId) {
            cancelAnimationFrame(animId);
            animId = null;
          }
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible && !prefersReducedMotion && !animId) {
        animate();
      } else if (!isVisible && animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOrbitalCanvas);
  } else {
    initOrbitalCanvas();
  }
</script>
