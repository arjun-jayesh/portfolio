---
interface Props {
  videoUrl?: string;
  headline?: string;
  subheadline?: string;
}

const {
  videoUrl = "/sample.mp4",
  headline = "Built to deliver. Not to impress.",
  subheadline = "KINBO Technologies engineers constraint-bound clinical infrastructure, computer vision platforms, and high-concurrency enterprise systems across India, China, and the GCC.",
} = Astro.props;
---

<section class="relative border-b border-offwhite/12 bg-charcoal overflow-hidden min-h-[85vh] flex items-center">
  {/* Ambient Cinematic Video Background behind Hero section */}
  {videoUrl && (
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        class="w-full h-full object-cover opacity-25 filter contrast-115 brightness-90"
      >
        <source src={videoUrl} type="video/mp4" />
      </video>

      {/* Dark Obsidian Architectural Gradient Overlays to Guarantee Text Readability */}
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/85 to-charcoal/60"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-charcoal/80 via-transparent to-charcoal"></div>

      {/* Subtle Architectural Dot Mesh */}
      <div
        class="absolute inset-0 opacity-[0.03] pointer-events-none"
        style="background-image: radial-gradient(circle, #F5F3EE 1px, transparent 1px); background-size: 32px 32px;"
      ></div>
    </div>
  )}

  {/* Foreground Hero Content Grid */}
  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-14 pt-12 pb-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      {/* Left 8 Columns: Asymmetric Editorial Thesis */}
      <div class="lg:col-span-8 space-y-6 lg:pr-8 lg:border-r lg:border-offwhite/12">
        <div class="inline-flex items-center gap-3 border border-offwhite/15 bg-charcoal-light/40 backdrop-blur-sm px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.18em]">
          <span class="h-2 w-2 bg-teal"></span>
          <span class="text-offwhite">SYSTEMS ARCHITECTURE &amp; APPLIED AI</span>
          <span class="text-muted hidden sm:inline">// DOC. REF 2026-K01</span>
        </div>

        <h1 class="font-display text-5xl sm:text-6xl lg:text-[5.25rem] text-offwhite leading-[1.02] tracking-tight">
          {headline}
        </h1>

        <p class="font-lora text-base sm:text-lg lg:text-xl text-offwhite/85 max-w-2xl leading-relaxed">
          {subheadline}
        </p>

        {/* Action Bar */}
        <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="/ideas"
            class="px-7 py-4 bg-teal text-charcoal font-mono text-xs uppercase tracking-[0.18em] font-bold rounded-sm text-center hover:opacity-90 transition-opacity"
          >
            Commission System / RFP &rarr;
          </a>
          <a
            href="/products"
            class="px-7 py-4 border border-offwhite/20 bg-charcoal-light/40 backdrop-blur-sm text-offwhite font-mono text-xs uppercase tracking-[0.18em] rounded-sm text-center hover:border-teal transition-colors"
          >
            Inspect Product Suite
          </a>
          <a
            href="/founder"
            class="px-5 py-4 font-mono text-xs uppercase tracking-[0.16em] text-muted hover:text-offwhite text-center transition-colors"
          >
            Founder Dossier &nearr;
          </a>
        </div>

        {/* Bottom Key Metrics Strip */}
        <div class="pt-8 mt-8 border-t border-offwhite/12 grid grid-cols-2 sm:grid-cols-4 gap-6 font-mono">
          <div>
            <div class="text-[10px] uppercase tracking-widest text-muted">FLAGSHIP CLINICAL</div>
            <div class="text-lg sm:text-xl font-semibold text-offwhite mt-1 tabular-nums">
              QueueZero (Q0)
            </div>
            <div class="text-[11px] text-teal">OPD &amp; Triage Engine</div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-muted">COMPUTER VISION</div>
            <div class="text-lg sm:text-xl font-semibold text-offwhite mt-1 tabular-nums">
              Glowup AI
            </div>
            <div class="text-[11px] text-teal">Dermatological Scoring</div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-muted">WEB ECOSYSTEM</div>
            <div class="text-lg sm:text-xl font-semibold text-offwhite mt-1 tabular-nums">
              100+ Titles
            </div>
            <div class="text-[11px] text-teal">GameVerse Runtime</div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-muted">OPERATIONAL FOOTPRINT</div>
            <div class="text-lg sm:text-xl font-semibold text-offwhite mt-1 tabular-nums">
              3 Regions
            </div>
            <div class="text-[11px] text-teal">IN // CN // GCC</div>
          </div>
        </div>
      </div>

      {/* Right 4 Columns: Architectural Specification Ledger & Hardware Telemetry */}
      <div class="lg:col-span-4 space-y-5">
        <div class="border border-offwhite/15 bg-charcoal-light/25 backdrop-blur-md rounded-sm">
          <div class="px-4 py-3 border-b border-offwhite/12 flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-muted bg-charcoal-dark/70">
            <span class="text-teal font-semibold">DIVISIONAL LEDGER</span>
            <span>STATUS: ACTIVE</span>
          </div>

          <div class="divide-y divide-offwhite/10 font-mono text-xs">
            <a
              href="/services/cares"
              class="block p-4 hover:bg-charcoal-light/50 transition-colors group"
            >
              <div class="flex items-center justify-between text-[10px] text-teal mb-1">
                <span>01 // KINBO CARES</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
              <div class="font-poppins font-semibold text-sm text-offwhite">
                Production Reliability &amp; System Audits
              </div>
              <p class="font-lora text-xs text-muted mt-1">
                Continuous uptime engineering, security remediation, and SLA-backed maintenance.
              </p>
            </a>

            <a
              href="/services/consultancy"
              class="block p-4 hover:bg-charcoal-light/50 transition-colors group"
            >
              <div class="flex items-center justify-between text-[10px] text-teal mb-1">
                <span>02 // KINBO CONSULTANCY</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
              <div class="font-poppins font-semibold text-sm text-offwhite">
                Architecture &amp; Stack Modernization
              </div>
              <p class="font-lora text-xs text-muted mt-1">
                Transitioning legacy monoliths into deterministic edge and SSR architectures.
              </p>
            </a>

            <a
              href="/services/expert"
              class="block p-4 hover:bg-charcoal-light/50 transition-colors group"
            >
              <div class="flex items-center justify-between text-[10px] text-teal mb-1">
                <span>03 // KINBO EXPERT</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
              <div class="font-poppins font-semibold text-sm text-offwhite">
                Fractional CTO &amp; Deep-Tech R&amp;D
              </div>
              <p class="font-lora text-xs text-muted mt-1">
                Principal-level leadership for clinical AI, RAG verification, and high-load systems.
              </p>
            </a>
          </div>
        </div>

        {/* Architectural Runtime Telemetry Readout */}
        <div class="border border-offwhite/15 bg-charcoal-light/25 backdrop-blur-md rounded-sm p-4 font-mono text-xs space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-offwhite/10 text-[10px] uppercase tracking-widest text-muted">
            <span class="text-teal font-semibold">RUNTIME TELEMETRY</span>
            <span class="inline-flex items-center gap-1.5 text-offwhite">
              <span class="h-1.5 w-1.5 bg-teal animate-pulse"></span>
              <span>LIVE // 60 FPS</span>
            </span>
          </div>
          <div class="space-y-1.5 text-[11px]">
            <div class="flex justify-between text-muted">
              <span>LATENCY:</span>
              <span class="text-offwhite tabular-nums">&lt; 42ms (EDGE P99)</span>
            </div>
            <div class="flex justify-between text-muted">
              <span>ARCHITECTURE:</span>
              <span class="text-offwhite">ASTRO 5 + PREACT 10</span>
            </div>
            <div class="flex justify-between text-muted">
              <span>FOOTPRINT:</span>
              <span class="text-teal">INDIA // CHINA // GCC</span>
            </div>
            <div class="flex justify-between text-muted">
              <span>PIPELINE:</span>
              <span class="text-offwhite">QUEUEZERO + GLOWUP AI</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
