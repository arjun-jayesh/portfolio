          <rect x="91" y="4" width="9.2" height="38" fill="#F4F3EF"/>
          <circle cx="107.5" cy="27.8" r="14.7" fill="#F4F3EF"/>
          <circle cx="107.5" cy="27.8" r="7.5" fill="#111111"/>
          <circle class="bo-dot" cx="110.2" cy="25.1" r="3.3" fill="#D9261C" style="transform:translate(var(--dot-tx,0px),var(--dot-ty,0px));transition:transform 0.35s cubic-bezier(0.16,1,0.3,1)"/>
          <circle cx="143.5" cy="27.8" r="14.7" fill="#F4F3EF"/>
          <circle cx="143.5" cy="27.8" r="7.5" fill="#111111"/>
          <circle class="bo-dot" cx="146.2" cy="25.1" r="3.3" fill="#D9261C" style="transform:translate(var(--dot-tx,0px),var(--dot-ty,0px));transition:transform 0.35s cubic-bezier(0.16,1,0.3,1)"/>
