---
import "../styles/global.css";
import DirectEngineerModal from "../components/DirectEngineerModal";
import { supabase, supabaseAdmin } from "../lib/supabase";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  schemaType?: "WebSite" | "Service" | "FAQPage" | "AboutPage" | "ContactPage";
  hideHeaderFooter?: boolean;
}

const {
  title = "KINBO - Custom Software Engineering & Architecture",
  description = "We don't have a sales team. You talk directly to the engineer from day one. Mobile apps, web platforms, ERPs, and custom AI systems built with lifelong support.",
  image = "/favicon.png",
  canonical,
  schemaType = "WebSite",
  hideHeaderFooter = false,
} = Astro.props;

let enterpriseAssets: Record<string, any> = {};
let primarySettings: Record<string, any> = {};

const db = supabaseAdmin || supabase;
if (db) {
  try {
    const { data: configs } = await db
      .from("site_config")
      .select("key, data")
      .in("key", ["enterprise_assets", "primary_settings"]);
    if (configs) {
      for (const item of configs) {
        if (item.key === "enterprise_assets" && item.data) enterpriseAssets = item.data;
        if (item.key === "primary_settings" && item.data) primarySettings = item.data;
      }
    }
  } catch {
    // Graceful fallback to static defaults
  }
}

const whatsappNumber = enterpriseAssets.whatsapp_number || "919074811984";
const defaultWhatsAppMsg = enterpriseAssets.whatsapp_default_message || "Hello kinbo Engineer, I would like to discuss a software project.";
const waCleanNumber = whatsappNumber.replace(/[^0-9]/g, "");
const siteUrl = "https://kinbosoft.com";
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;

const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": siteUrl
  },
  ...pathSegments.map((segment, index) => ({
    "@type": "ListItem",
    "position": index + 2,
    "name": segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " "),
    "item": `${siteUrl}/${pathSegments.slice(0, index + 1).join("/")}`
  }))
];

const jsonLdGraph: Record<string, any> = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "KINBO TECHNOLOGIES PRIVATE LIMITED",
      "alternateName": ["KINBO", "Kinbo Technologies"],
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.png`,
      "image": `${siteUrl}/favicon.png`,
      "founder": {
        "@type": "Person",
        "name": "Arjun Jayesh",
        "jobTitle": "Founder & Systems Architect",
        "url": `${siteUrl}/founder`
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": `+${waCleanNumber}`,
          "contactType": "engineering support",
          "availableLanguage": ["English", "Hindi", "Malayalam"]
        }
      ],
      "sameAs": [
        "https://www.linkedin.com/company/kinbosoft",
        "https://github.com/arjun-jayesh"
      ]
    },
    {
      "@type": schemaType,
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#organization` }
    }
  ]
};

if (pathSegments.length > 0) {
  jsonLdGraph["@graph"].push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": breadcrumbItems
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Favicon & Icons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="describedby" href="/llms.txt" />
    <link rel="describedby" href="/.well-known/llms.txt" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" />
    <meta name="content-signal" content="search=yes, ai-input=yes, ai-train=yes" />

    {/* Preconnect Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    {/* Open Graph / Social */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {/* Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
      <Analytics />
  </head>
  <body class="bg-[#050505] text-[#F4F3EF] selection:bg-[#D9261C] selection:text-white">
    {/* Accessible Skip Link */}
    <a href="#main-content" class="skip-link">Skip to content</a>

    {/* Deduplicated Brand SVG Sprite */}
    <svg class="svg-sprite" aria-hidden="true" focusable="false">
      <defs>
