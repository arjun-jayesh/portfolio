# ==============================================================================
# KINBO TECHNOLOGIES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your production or local secrets.
# NEVER commit .env to version control or share secrets publicly.
# ==============================================================================

# Core Application URL
PUBLIC_SITE_URL=https://kinbosoft.com
SITE_URL=https://kinbosoft.com

# Supabase (PostgreSQL Database & Authentication)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_private_supabase_service_role_key_here

# Admin Authentication
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SECRET=your_32_character_random_admin_session_hmac_secret_here

# Cloudinary (Media Assets & Signed Uploads)
PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_for_signed_uploads

# Razorpay (Payment Processing)
PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudflare Turnstile (Anti-Bot & Rate Limiting Protection)
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Vanity Domain Redirect Proxy Target
# Default: 18.133.72.105 (AWS EC2 redirect ingress proxy)
REDIRECT_PROXY_IP=18.133.72.105
